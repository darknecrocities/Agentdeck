# ── AgentDeck Control Plane Environment Configuration ───────────────
# Default server host and port
AGENTDECK_HOST=0.0.0.0
AGENTDECK_PORT=8765

# Google / Antigravity Account Email (Auto-detected from ~/.gemini if unset)
GOOGLE_ACCOUNT_EMAIL=developer@example.com

# Tailscale Host IP or MagicDNS Hostname (Auto-detected via `tailscale ip -4` if unset)
# TAILSCALE_HOST_IP=100.x.y.z
# TAILSCALE_MAGIC_DNS=my-workstation.tailnet.ts.net

# Optional Security Authentication Bearer Token for Remote Mobile Clients
# AGENTDECK_AUTH_TOKEN=your_secure_random_token_here

# Anthropic Claude API Key (Optional fallback if not using CLI auth)
# ANTHROPIC_API_KEY=

# OpenAI API Key (Optional fallback if not using CLI auth)
# OPENAI_API_KEY=
