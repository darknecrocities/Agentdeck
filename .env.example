# ═══════════════════════════════════════════════════════════════
# AgentDeck Environment Variables
# Copy this file to .env and customize values for your setup
# ═══════════════════════════════════════════════════════════════

# ── Server Configuration ──────────────────────────────────────
AGENTDECK_HOST=0.0.0.0
AGENTDECK_PORT=8765
AGENTDECK_DB_PATH=agentdeck.db

# ── Logging ───────────────────────────────────────────────────
# Levels: trace, debug, info, warn, error
AGENTDECK_LOG_LEVEL=info
RUST_LOG=agentdeck=info,agentdeckd=info,tower_http=info

# ── Security ──────────────────────────────────────────────────
# Set to true to require Authorization: Bearer <token> on all API requests
AGENTDECK_REQUIRE_AUTH=false
# Token for authenticating mobile client connections (change in production!)
AGENTDECK_AUTH_TOKEN=agentdeck-dev-token-change-me

# ── Network Mode ──────────────────────────────────────────────
# Options: tailscale, localhost, all
AGENTDECK_NETWORK_MODE=tailscale

# ── Agent Binaries ────────────────────────────────────────────
# Override agent binary paths if not in $PATH
AGENTDECK_AGY_BINARY=agy
AGENTDECK_CLAUDE_BINARY=claude
AGENTDECK_GEMINI_BINARY=gemini
AGENTDECK_OLLAMA_BINARY=ollama

# ── Agent Toggles ─────────────────────────────────────────────
AGENTDECK_AGY_ENABLED=true
AGENTDECK_CLAUDE_ENABLED=true
AGENTDECK_GEMINI_ENABLED=true
AGENTDECK_OLLAMA_ENABLED=true

# ── Project Roots (comma-separated) ──────────────────────────
AGENTDECK_PROJECT_ROOTS=/path/to/your/projects

# ── GitHub (optional — prefer gh CLI auth) ────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Tailscale (auto-detected, override only if needed) ────────
# AGENTDECK_TAILSCALE_IP=100.x.x.x

# ── Multi-Machine Tailscale Fleet Endpoints (Optional) ────────
# AGENTDECK_MAC_ENDPOINT=http://100.x.x.x:8765
# AGENTDECK_WINDOWS_ENDPOINT=http://100.x.x.x:8765
# AGENTDECK_LINUX_ENDPOINT=http://100.x.x.x:8765
