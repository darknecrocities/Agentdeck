        tool_write_file(html_path, html_content, working_dir)
        tool_write_file(css_path, css_content, working_dir)
        tool_write_file(js_path, js_content, working_dir)
        created_files.extend([html_path, css_path, js_path])

    # Final summary output
    print("\033[1;32m━" * 64 + "\033[0m")
