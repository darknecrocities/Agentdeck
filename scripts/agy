#!/usr/bin/env python3
"""
Google Antigravity Engine (AGY CLI v2.0 - Autonomous Vibecoding Agent)
Full-Access Autonomous Software Engineering Agent with Real-Time Streaming,
Live Tool Execution, Code Generation, File Diffing, Web Browsing, and Artifact Synthesis.
"""
import sys
import os
import re
import json
import time
import argparse
import subprocess
import threading
import urllib.request
import urllib.parse
from pathlib import Path

HOME = str(Path.home())
OLLAMA_ENDPOINT = os.getenv("OLLAMA_ENDPOINT", "http://127.0.0.1:11434/api/generate")
DEFAULT_MODEL = os.getenv("AGENTDECK_LOCAL_MODEL", "qwen2.5-coder:7b")

SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

class LiveProgress:
    def __init__(self, message="Antigravity thinking & planning..."):
        self.message = message
        self.running = False
        self.thread = None

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def update(self, new_message):
        self.message = new_message

    def _spin(self):
        idx = 0
        while self.running:
            frame = SPINNER_FRAMES[idx % len(SPINNER_FRAMES)]
            sys.stdout.write(f"\r\033[1;32m{frame}\033[0m \033[36m{self.message}\033[0m\033[K")
            sys.stdout.flush()
            idx += 1
            time.sleep(0.08)

    def stop(self, final_text=None):
        if self.running:
            self.running = False
            if self.thread:
                self.thread.join(timeout=0.2)
            sys.stdout.write("\r\033[K")
            if final_text:
                sys.stdout.write(f"{final_text}\n")
            sys.stdout.flush()

def print_banner(model="Gemini 3.7 Flash", effort="High"):
    print("\033[1;37m" + "━" * 64 + "\033[0m")
    print(f"\033[1;32m● GOOGLE ANTIGRAVITY ENGINE (AGY CLI v2.0 - AUTONOMOUS AGENT)\033[0m")
    print(f"\033[36mModel:\033[0m \033[1;37m{model}\033[0m  │  \033[36mEffort:\033[0m \033[1;37m{effort}\033[0m  │  \033[32mFull System Access\033[0m")
    print("\033[1;37m" + "━" * 64 + "\033[0m")

def clean_path_string(path_str):
    s = path_str.strip()
    for q in ('"', "'", '`'):
        if s.startswith(q) and s.endswith(q):
            s = s[1:-1].strip()
    s = re.sub(r'^(?:#|//|<!--|filepath:|path:)\s*', '', s, flags=re.IGNORECASE).strip()
    return s

def normalize_path(path_str, cwd):
    clean = clean_path_string(path_str)
    clean = os.path.expanduser(clean)
    if clean.startswith("Users/") or clean.startswith("home/"):
        clean = "/" + clean
    if not os.path.isabs(clean):
        return os.path.abspath(os.path.join(cwd, clean))
    return os.path.abspath(clean)

def format_line_ansi(line, in_code_block=False):
    """
    Transforms markdown syntax (###, *, **, `, ```) into rich ANSI terminal formatting.
    """
    if in_code_block:
        # Subtle indentation and syntax highlight for code lines
        hl = line
        hl = re.sub(r'\b(const|let|var|function|return|if|else|import|export|from|class|default|async|await)\b', r'\033[1;35m\1\033[38;5;250m', hl)
        hl = re.sub(r'\b(true|false|null|undefined)\b', r'\033[33m\1\033[38;5;250m', hl)
        return f"\033[38;5;250m    {hl}\033[0m"

    # Headers
    if line.startswith("# "):
        header_text = line[2:].strip()
        return f"\n\033[1;37m━━━━━━━━━━━━━━━━━━━━ \033[1;32m{header_text}\033[1;37m ━━━━━━━━━━━━━━━━━━━━\033[0m"
    elif line.startswith("## "):
        header_text = line[3:].strip()
        return f"\n\033[1;32m■ \033[1;37m{header_text}\033[0m"
    elif line.startswith("### "):
        header_text = line[4:].strip()
        return f"\n\033[1;36m▶ \033[1;37m{header_text}\033[0m"
    elif line.startswith("#### "):
        header_text = line[5:].strip()
        return f"\033[1;33m◆ \033[1;37m{header_text}\033[0m"

    # Bullet lists (* or -)
    if re.match(r'^\s*[\*\-]\s+', line):
        content = re.sub(r'^\s*[\*\-]\s+', '', line).strip()
        content = format_inline_markdown(content)
        return f"  \033[1;32m•\033[0m {content}"

    # Numbered lists (1. 2.)
    m_num = re.match(r'^\s*(\d+)\.\s+(.*)', line)
    if m_num:
        num = m_num.group(1)
        content = format_inline_markdown(m_num.group(2))
        return f"  \033[1;36m{num}.\033[0m {content}"

    return format_inline_markdown(line)

def format_inline_markdown(text):
    out = text
    # Bold **text** -> Bright Titanium White Bold
    out = re.sub(r'\*\*(.*?)\*\*', r'\033[1;37m\1\033[0m', out)
    # Italic *text* -> Italic
    out = re.sub(r'(?<!\*)\*([^*]+)\*(?!\*)', r'\033[3m\1\033[0m', out)
    # Inline code `code` -> Gold/Amber
    out = re.sub(r'`([^`]+)`', r'\033[1;33m\1\033[0m', out)
    return out

class TerminalStreamRenderer:
    """
    Parses streaming chunks in real-time and renders structured ANSI code blocks,
    headers, and badges without dumping raw markdown backticks or tool JSON.
    """
    def __init__(self):
        self.buffer = ""
        self.in_code_block = False
        self.is_tool_block = False
        self.code_target = ""

    def process_chunk(self, chunk):
        self.buffer += chunk
        lines = self.buffer.split("\n")
        # Keep last partial line in buffer
        self.buffer = lines[-1]
        rendered_lines = []

        for line in lines[:-1]:
            if line.startswith("```"):
                if not self.in_code_block:
                    self.in_code_block = True
                    tag = line.strip("`").strip()
                    if "tool" in tag:
                        self.is_tool_block = True
                        continue
                    self.is_tool_block = False
                    # Extract file path if present
                    m_path = re.search(r'(?:filepath:|path:)\s*([^\s]+)', tag)
                    target = m_path.group(1) if m_path else tag
                    self.code_target = target
                    rendered_lines.append(f"\n\033[90m┌─── \033[1;32m[File: {target or 'Source'}]\033[90m " + "─" * max(10, 48 - len(target or 'Source')) + "\033[0m")
                else:
                    self.in_code_block = False
                    if not self.is_tool_block:
                        rendered_lines.append(f"\033[90m└─── \033[36m[End File: {self.code_target or 'Source'}]\033[90m " + "─" * max(10, 44 - len(self.code_target or 'Source')) + "\033[0m\n")
                    self.is_tool_block = False
                    self.code_target = ""
                continue

            if self.is_tool_block:
                # Suppress raw JSON from tool block, will execute after stream
                continue

            rendered_lines.append(format_line_ansi(line, in_code_block=self.in_code_block))

        if rendered_lines:
            output_str = "\n".join(rendered_lines) + "\n"
            sys.stdout.write(output_str)
            sys.stdout.flush()

    def flush(self):
        if self.buffer.strip():
            if not self.is_tool_block:
                sys.stdout.write(format_line_ansi(self.buffer, in_code_block=self.in_code_block) + "\n")
                sys.stdout.flush()
        if self.in_code_block and not self.is_tool_block:
            sys.stdout.write(f"\033[90m└─── \033[36m[End File Block]\033[90m " + "─" * 44 + "\033[0m\n")
            sys.stdout.flush()
        self.buffer = ""

def tool_write_file(path_str, content, cwd):
    target = normalize_path(path_str, cwd)
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
        is_new = not os.path.exists(target)
        line_count = len(content.splitlines())
        with open(target, "w", encoding="utf-8") as f:
            f.write(content)
        if is_new:
            print(f"\033[1;32m✓ [File Created]\033[0m \033[1;37m{target}\033[0m \033[90m(+{line_count} lines)\033[0m")
        else:
            print(f"\033[1;33mΔ [File Modified]\033[0m \033[1;37m{target}\033[0m \033[90m({line_count} lines updated)\033[0m")
        return target
    except Exception as e:
        print(f"\033[1;31m✗ [File Write Error]\033[0m {target}: {e}")
        return None

def tool_run_command(cmd, cwd):
    cmd_clean = cmd.strip()
    print(f"\033[1;34m⚡ [Running Command]\033[0m \033[1;37m{cmd_clean}\033[0m")
    try:
        res = subprocess.run(cmd_clean, shell=True, cwd=cwd, capture_output=True, text=True, timeout=60)
        out = (res.stdout + res.stderr).strip()
        if out:
            for line in out.splitlines()[:15]:
                print(f"  \033[90m│\033[0m {line}")
        exit_code = res.returncode
        if exit_code == 0:
            print(f"  \033[1;32m✓\033[0m \033[90mExit 0 (Success)\033[0m")
        else:
            print(f"  \033[1;31m✗\033[0m \033[90mExit {exit_code}\033[0m")
        return out if out else ""
    except Exception as e:
        print(f"\033[1;31m✗ [Command Error]\033[0m {e}")
        return f"Error: {e}"

def query_llm_stream(system_prompt, user_prompt, model_name=DEFAULT_MODEL):
    full_prompt = f"<|im_start|>system\n{system_prompt}<|im_end|>\n<|im_start|>user\n{user_prompt}<|im_end|>\n<|im_start|>assistant\n"
    payload = json.dumps({
        "model": model_name,
        "prompt": full_prompt,
        "stream": True,
        "options": {
            "temperature": 0.2,
            "num_ctx": 16384
        }
    }).encode("utf-8")

    req = urllib.request.Request(
        OLLAMA_ENDPOINT,
        data=payload,
        headers={"Content-Type": "application/json"}
    )

    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            for line in resp:
                if line:
                    chunk = json.loads(line.decode("utf-8"))
                    yield chunk.get("response", "")
                    if chunk.get("done", False):
                        break
    except Exception as e:
        yield f"\n[LLM Stream Error: {e}]\n"

def execute_agent_tools(response_text, cwd):
    created_files = []
    executed_commands = []

    # 1. Parse JSON tool calls
    tool_blocks = re.findall(r'```(?:json:tool|tool|json)\s*\n(\{[^`]*?\})\s*```', response_text, re.DOTALL)
    for tb in tool_blocks:
        try:
            data = json.loads(tb.strip())
            tool = data.get("tool")
            args = data.get("args", {})
            if tool == "write_file":
                p = tool_write_file(args.get("path", ""), args.get("content", ""), cwd)
                if p: created_files.append(p)
            elif tool == "run_command":
                cmd = args.get("cmd", "")
                tool_run_command(cmd, cwd)
                executed_commands.append(cmd)
            elif tool == "open_target":
                target = args.get("target", "")
                print(f"\033[1;36m🚀 [Opening Target]\033[0m {target}")
                subprocess.run(f"open '{target}'", shell=True)
        except Exception:
            pass

    # 2. Parse file blocks with explicit file headers
    file_blocks = re.findall(r'```(?:[a-zA-Z0-9_\-]+)?\s*(?:filepath:|path:)\s*([^\n\r`]+)\n([\s\S]*?)```', response_text)
    for path_raw, content in file_blocks:
        path_clean = clean_path_string(path_raw)
        if not path_clean.startswith(('mkdir', 'cd', 'python', 'sh', 'bash', 'npm', 'git', 'cargo')):
            if "." in path_clean or "/" in path_clean:
                p = tool_write_file(path_clean, content, cwd)
                if p and p not in created_files:
                    created_files.append(p)

    return created_files, executed_commands

def run_agent_task(prompt, model="Gemini 3.7 Flash", effort="High", working_dir=None):
    if working_dir is None:
        working_dir = os.getcwd()

    progress = LiveProgress(f"Antigravity ({model}) analyzing & synthesizing plan...")
    progress.start()

    system_prompt = f"""You are Antigravity, Google's elite autonomous software engineering AI agent.
You have FULL LOCAL SYSTEM ACCESS on macOS.
Active working directory: {working_dir}
User home directory: {HOME}

When the user asks you to build, create, or code something:
1. Plan the project structure and explain your approach concisely.
2. ALWAYS output complete code files using this EXACT format:
```html filepath:{HOME}/Documents/project_name/index.html
<!DOCTYPE html>
...complete code...
```

```css filepath:{HOME}/Documents/project_name/style.css
...complete code...
```

```js filepath:{HOME}/Documents/project_name/app.js
...complete code...
```

3. To execute shell commands:
```json:tool
{{"tool": "run_command", "args": {{"cmd": "mkdir -p {HOME}/Documents/project_name"}}}}
```

4. Write modern, stunning, responsive, dark themed UI with glassmorphism and interactive JavaScript.
5. Never output placeholders or truncated code. Always write complete files."""

    response_text = ""
    first_token = True
    renderer = TerminalStreamRenderer()

    try:
        for token in query_llm_stream(system_prompt, prompt, model_name=DEFAULT_MODEL):
            if first_token:
                progress.stop(f"\033[1;32m▶ Antigravity ({model}) Stream:\033[0m\n")
                first_token = False
            response_text += token
            renderer.process_chunk(token)
    finally:
        progress.stop()
        renderer.flush()

    print("\n\033[1;37m" + "─" * 64 + "\033[0m")
    print("\033[1;36m▶ Executing Actions & Writing Artifacts to Filesystem...\033[0m\n")

    created_files, executed_commands = execute_agent_tools(response_text, working_dir)

    # Final summary output
    print("\033[1;32m━" * 64 + "\033[0m")
    print(f"\033[1;32m✓ ANTIGRAVITY TASK COMPLETED SUCCESSFULLY\033[0m")
    if created_files:
        print(f"\033[1;37m📄 Created Artifacts & Files ({len(created_files)} total):\033[0m")
        for f in created_files:
            print(f"  \033[32m•\033[0m \033[1;37m{f}\033[0m")
    print("\033[1;32m━" * 64 + "\033[0m\n")

def interactive_repl(model, effort):
    print_banner(model, effort)
    print("\033[90mConnected to Live Antigravity Engine (Full Laptop Access). Type prompt, '/help', or 'exit'.\033[0m\n")

    current_dir = os.getcwd()

    while True:
        try:
            sys.stdout.write(f"\033[1;37magy ({model})>\033[0m ")
            sys.stdout.flush()
            line = sys.stdin.readline()
            if not line:
                break
            prompt = line.strip()
            if not prompt:
                continue
            if prompt.lower() in ("exit", "quit", "/exit", "/quit"):
                print("\033[90mAntigravity session ended.\033[0m")
                break
            if prompt.lower() in ("clear", "/clear"):
                os.system("clear")
                print_banner(model, effort)
                continue
            if prompt.lower() in ("/help", "help"):
                print("\n\033[1;37mAntigravity CLI Commands:\033[0m")
                print("  /model <name>   - Change active reasoning model")
                print("  /clear          - Clear terminal canvas")
                print("  /exit           - Exit session")
                print("  <any prompt>    - Vibecode websites, create files, run shell commands, manage laptop\n")
                continue
            if prompt.startswith("/model "):
                model = prompt[7:].strip()
                print(f"\033[32mSwitched model to {model}\033[0m")
                continue

            run_agent_task(prompt, model=model, effort=effort, working_dir=current_dir)
        except KeyboardInterrupt:
            print("\n\033[90mSession interrupted.\033[0m")
            break

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--version", "-v", "version"):
        print("Antigravity CLI v2.0.0 (Google Antigravity Engine)")
        sys.exit(0)

    parser = argparse.ArgumentParser(description="Antigravity CLI Control Interface", add_help=False)
    parser.add_argument("--model", "-m", default="Gemini 3.7 Flash", help="Antigravity Model")
    parser.add_argument("--effort", "-e", default="High", help="Reasoning Effort")
    parser.add_argument("--prompt", "-p", default="", help="Single prompt execution")
    parser.add_argument("rest", nargs="*", help="Direct prompt arguments")

    args, unknown = parser.parse_known_args()

    model = args.model
    effort = args.effort
    prompt_parts = []
    if args.prompt:
        prompt_parts.append(args.prompt)
    if args.rest:
        prompt_parts.extend(args.rest)
    if unknown:
        prompt_parts.extend(unknown)

    prompt = " ".join(prompt_parts).strip()

    if prompt:
        print_banner(model, effort)
        run_agent_task(prompt, model=model, effort=effort)
    else:
        interactive_repl(model, effort)

if __name__ == "__main__":
    main()
