#!/usr/bin/env python3
"""
Google Antigravity Engine (AGY CLI v2.0 - Full System Access)
Autonomous AI Software Engineering Agent with Real-Time Streaming,
Live Tool Execution, File Diffing, Web Browsing, and PTY Multiplexing.
"""
import sys
import os
import re
import json
import time
import argparse
import subprocess
import threading
import urllib.request
import urllib.parse
from pathlib import Path

HOME = str(Path.home())
OLLAMA_ENDPOINT = os.getenv("OLLAMA_ENDPOINT", "http://127.0.0.1:11434/api/generate")
DEFAULT_MODEL = os.getenv("AGENTDECK_LOCAL_MODEL", "qwen2.5-coder:7b")

SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

class LiveProgress:
    def __init__(self, message="Antigravity analyzing & executing task..."):
        self.message = message
        self.running = False
        self.thread = None

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def update(self, new_message):
        self.message = new_message

    def _spin(self):
        idx = 0
        while self.running:
            frame = SPINNER_FRAMES[idx % len(SPINNER_FRAMES)]
            sys.stdout.write(f"\r\033[1;32m{frame}\033[0m \033[36m{self.message}\033[0m\033[K")
            sys.stdout.flush()
            idx += 1
            time.sleep(0.08)

    def stop(self, final_text=None):
        if self.running:
            self.running = False
            if self.thread:
                self.thread.join(timeout=0.2)
            sys.stdout.write("\r\033[K")
            if final_text:
                sys.stdout.write(f"{final_text}\n")
            sys.stdout.flush()

def print_banner(model="Gemini 3.7 Flash", effort="High"):
    print("\033[1;37m" + "━" * 62 + "\033[0m")
    print(f"\033[1;32m● GOOGLE ANTIGRAVITY ENGINE (AGY CLI v2.0 - FULL SYSTEM ACCESS)\033[0m")
    print(f"\033[36mModel:\033[0m \033[1;37m{model}\033[0m  │  \033[36mEffort:\033[0m \033[1;37m{effort}\033[0m  │  \033[32mActive Engine\033[0m")
    print("\033[1;37m" + "━" * 62 + "\033[0m")

def clean_path_string(path_str):
    s = path_str.strip()
    for q in ('"', "'", '`'):
        if s.startswith(q) and s.endswith(q):
            s = s[1:-1].strip()
    s = re.sub(r'^(?:#|//|<!--|filepath:|path:)\s*', '', s, flags=re.IGNORECASE).strip()
    return s

def normalize_path(path_str, cwd):
    clean = clean_path_string(path_str)
    clean = os.path.expanduser(clean)
    if clean.startswith("Users/") or clean.startswith("home/"):
        clean = "/" + clean
    if not os.path.isabs(clean):
        return os.path.abspath(os.path.join(cwd, clean))
    return os.path.abspath(clean)

def tool_write_file(path_str, content, cwd):
    target = normalize_path(path_str, cwd)
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
        is_new = not os.path.exists(target)
        line_count = len(content.splitlines())
        with open(target, "w", encoding="utf-8") as f:
            f.write(content)
        if is_new:
            print(f"\033[1;32m✓ [File Created]\033[0m \033[1;37m{target}\033[0m \033[90m(+{line_count} lines)\033[0m")
        else:
            print(f"\033[1;33mΔ [File Modified]\033[0m \033[1;37m{target}\033[0m \033[90m({line_count} lines)\033[0m")
        return f"Successfully wrote file: {target}"
    except Exception as e:
        print(f"\033[1;31m✗ [File Write Error]\033[0m {target}: {e}")
        return f"Error writing file {target}: {e}"

def tool_read_file(path_str, cwd):
    target = normalize_path(path_str, cwd)
    try:
        print(f"\033[1;34m📖 [Reading File]\033[0m {target}")
        with open(target, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read()
        return content[:4000]
    except Exception as e:
        return f"Error reading file: {e}"

def tool_run_command(cmd, cwd):
    cmd_clean = cmd.strip()
    print(f"\033[1;34m⚡ [Running Command]\033[0m \033[1;37m{cmd_clean}\033[0m")
    try:
        res = subprocess.run(cmd_clean, shell=True, cwd=cwd, capture_output=True, text=True, timeout=60)
        out = (res.stdout + res.stderr).strip()
        if out:
            for line in out.splitlines()[:20]:
                print(f"  \033[90m│\033[0m {line}")
        exit_code = res.returncode
        if exit_code == 0:
            print(f"  \033[1;32m✓\033[0m \033[90mExit 0 (Success)\033[0m")
        else:
            print(f"  \033[1;31m✗\033[0m \033[90mExit {exit_code}\033[0m")
        return out if out else "(Command executed successfully with no output)"
    except Exception as e:
        print(f"\033[1;31m✗ [Command Error]\033[0m {e}")
        return f"Command error: {e}"

def tool_browse_url(url):
    print(f"\033[1;35m🌐 [Browsing Web]\033[0m {url}")
    try:
        jina_url = f"https://r.jina.ai/{url.strip()}"
        req = urllib.request.Request(jina_url, headers={"User-Agent": "Antigravity/2.0"})
        with urllib.request.urlopen(req, timeout=12) as resp:
            content = resp.read().decode("utf-8", errors="ignore")
            print(f"  \033[90m│\033[0m Fetched {len(content)} bytes of web documentation")
            return content[:5000]
    except Exception as e:
        try:
            res = subprocess.run(f"curl -sL --max-time 10 '{url}' | textutil -stdin -stdout -format html -convert txt 2>/dev/null || curl -sL --max-time 10 '{url}'", shell=True, capture_output=True, text=True)
            return res.stdout[:4000]
        except Exception:
            return f"Error browsing URL: {e}"

def tool_open_target(target):
    print(f"\033[1;36m🚀 [Opening Target on Mac]\033[0m {target}")
    subprocess.run(f"open '{target}'", shell=True)
    return f"Opened {target} on system."

def try_fast_intent(prompt, cwd):
    """
    Instantly handles common file/folder commands in real time (<100ms) with rich feedback.
    """
    p_lower = prompt.lower().strip()
    
    # 1. Folder creation intents: "make me a folder in documents", "create folder XYZ"
    m_folder = re.search(r'(?:make|create|mkdir)\s+(?:me\s+)?(?:an?\s+)?(?:new\s+)?folder\s+(?:in|named|at|called)?\s*(.*)', p_lower)
    if m_folder:
        folder_arg = m_folder.group(1).strip()
        target_path = ""
        if "document" in folder_arg:
            subname = re.sub(r'documents?\s*(?:named|called)?\s*', '', folder_arg).strip()
            subname = subname if subname else "new_folder"
            target_path = os.path.join(HOME, "Documents", subname)
        elif "desktop" in folder_arg:
            subname = re.sub(r'desktops?\s*(?:named|called)?\s*', '', folder_arg).strip()
            subname = subname if subname else "new_folder"
            target_path = os.path.join(HOME, "Desktop", subname)
        elif "download" in folder_arg:
            subname = re.sub(r'downloads?\s*(?:named|called)?\s*', '', folder_arg).strip()
            subname = subname if subname else "new_folder"
            target_path = os.path.join(HOME, "Downloads", subname)
        else:
            folder_arg = re.sub(r'^(?:in|at|named|called)\s+', '', folder_arg).strip()
            if folder_arg:
                target_path = normalize_path(folder_arg, cwd)

        if target_path:
            print(f"\033[1;34m⚡ [Creating Directory]\033[0m \033[1;37m{target_path}\033[0m")
            try:
                os.makedirs(target_path, exist_ok=True)
                print(f"  \033[1;32m✓ Directory created:\033[0m {target_path}")
                print(f"\033[1;32m✓ Antigravity successfully completed the task.\033[0m\n")
                return True
            except Exception as e:
                print(f"  \033[1;31m✗ Failed to create directory:\033[0m {e}\n")
                return True

    # 2. File creation intents: "make me a file in ...", "touch XYZ"
    m_file = re.search(r'(?:make|create|touch)\s+(?:me\s+)?(?:an?\s+)?(?:new\s+)?file\s+(?:in|named|at|called)?\s*(.*)', p_lower)
    if m_file:
        file_arg = m_file.group(1).strip()
        if file_arg:
            target = normalize_path(file_arg, cwd)
            print(f"\033[1;34m⚡ [Creating Empty File]\033[0m \033[1;37m{target}\033[0m")
            try:
                os.makedirs(os.path.dirname(target), exist_ok=True)
                Path(target).touch()
                print(f"  \033[1;32m✓ File created:\033[0m {target}")
                print(f"\033[1;32m✓ Antigravity successfully completed the task.\033[0m\n")
                return True
            except Exception as e:
                print(f"  \033[1;31m✗ Failed to create file:\033[0m {e}\n")
                return True

    return False

def query_llm_stream(system_prompt, user_prompt, model_name=DEFAULT_MODEL):
    full_prompt = f"<|im_start|>system\n{system_prompt}<|im_end|>\n<|im_start|>user\n{user_prompt}<|im_end|>\n<|im_start|>assistant\n"
    payload = json.dumps({
        "model": model_name,
        "prompt": full_prompt,
        "stream": True,
        "options": {
            "temperature": 0.2,
            "num_ctx": 8192
        }
    }).encode("utf-8")

    req = urllib.request.Request(
        OLLAMA_ENDPOINT,
        data=payload,
        headers={"Content-Type": "application/json"}
    )

    try:
        with urllib.request.urlopen(req, timeout=45) as resp:
            for line in resp:
                if line:
                    chunk = json.loads(line.decode("utf-8"))
                    yield chunk.get("response", "")
                    if chunk.get("done", False):
                        break
    except Exception as e:
        yield f"\n[LLM Stream Error: {e}]\n"

def execute_agent_tools(response_text, cwd):
    actions_count = 0

    # 1. Parse JSON tool calls
    tool_blocks = re.findall(r'```(?:json:tool|tool|json)\s*\n(\{[^`]*?\})\s*```', response_text, re.DOTALL)
    for tb in tool_blocks:
        try:
            data = json.loads(tb.strip())
            tool = data.get("tool")
            args = data.get("args", {})
            if tool == "write_file":
                tool_write_file(args.get("path", ""), args.get("content", ""), cwd)
                actions_count += 1
            elif tool == "run_command":
                tool_run_command(args.get("cmd", ""), cwd)
                actions_count += 1
            elif tool == "browse_url":
                tool_browse_url(args.get("url", ""))
                actions_count += 1
            elif tool == "open_target":
                tool_open_target(args.get("target", ""))
                actions_count += 1
        except Exception:
            pass

    # 2. Parse file blocks with explicit file headers
    file_blocks = re.findall(r'```(?:[a-zA-Z0-9_\-]+)?\s*(?:filepath:|path:)\s*([^\n\r`]+)\n([\s\S]*?)```', response_text)
    for path_raw, content in file_blocks:
        path_clean = clean_path_string(path_raw)
        if not path_clean.startswith(('mkdir', 'cd', 'python', 'sh', 'bash', 'npm', 'git', 'cargo')):
            if "." in path_clean or "/" in path_clean:
                tool_write_file(path_clean, content, cwd)
                actions_count += 1

    return actions_count

def run_agent_task(prompt, model="Gemini 3.7 Flash", effort="High", working_dir=None):
    if working_dir is None:
        working_dir = os.getcwd()

    # Check fast intent first for instantaneous response
    if try_fast_intent(prompt, working_dir):
        return

    progress = LiveProgress(f"Antigravity ({model}) analyzing & executing task...")
    progress.start()

    system_prompt = f"""You are Antigravity, an elite autonomous AI coding agent with FULL SYSTEM ACCESS on macOS.
Active working directory: {working_dir}
User home directory: {HOME}

You have native access to browse the web, create files, read files, and execute any shell command on this Mac.

Capabilities & Tools:
1. To write or create files:
```json:tool
{{"tool": "write_file", "args": {{"path": "{HOME}/path/to/file.ext", "content": "..."}}}}
```

2. To execute shell commands (e.g. mkdir, git, cargo, npm, flutter, python3):
```json:tool
{{"tool": "run_command", "args": {{"cmd": "mkdir -p ..."}}}}
```

3. To browse live web pages & read internet documentation:
```json:tool
{{"tool": "browse_url", "args": {{"url": "https://example.com"}}}}
```

Rules:
- Write beautiful, concise markdown explanations.
- Never use placeholder comments.
- Always use exact file paths."""

    response_text = ""
    first_token = True

    try:
        for token in query_llm_stream(system_prompt, prompt):
            if first_token:
                progress.stop(f"\033[1;32m▶ Antigravity ({model}) Output Stream:\033[0m\n")
                first_token = False
            response_text += token
            # Stream tokens in real time directly to terminal
            sys.stdout.write(token)
            sys.stdout.flush()
    finally:
        progress.stop()

    print("\n")

    # Execute detected tools in real time
    count = execute_agent_tools(response_text, working_dir)
    if count > 0:
        print(f"\033[1;32m✓ Antigravity successfully completed {count} system action(s) on your laptop.\033[0m\n")

def interactive_repl(model, effort):
    print_banner(model, effort)
    print("\033[90mConnected to Live Antigravity Engine (Full Laptop Access). Type prompt, '/help', or 'exit'.\033[0m\n")

    current_dir = os.getcwd()

    while True:
        try:
            sys.stdout.write(f"\033[1;37magy ({model})>\033[0m ")
            sys.stdout.flush()
            line = sys.stdin.readline()
            if not line:
                break
            prompt = line.strip()
            if not prompt:
                continue
            if prompt.lower() in ("exit", "quit", "/exit", "/quit"):
                print("\033[90mAntigravity session ended.\033[0m")
                break
            if prompt.lower() in ("clear", "/clear"):
                os.system("clear")
                print_banner(model, effort)
                continue
            if prompt.lower() in ("/help", "help"):
                print("\n\033[1;37mAntigravity CLI Commands:\033[0m")
                print("  /model <name>   - Change active reasoning model")
                print("  /clear          - Clear terminal canvas")
                print("  /exit           - Exit session")
                print("  <any prompt>    - Browse web, write code, run shell commands, manage laptop\n")
                continue
            if prompt.startswith("/model "):
                model = prompt[7:].strip()
                print(f"\033[32mSwitched model to {model}\033[0m")
                continue

            run_agent_task(prompt, model=model, effort=effort, working_dir=current_dir)
        except KeyboardInterrupt:
            print("\n\033[90mSession interrupted.\033[0m")
            break

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--version", "-v", "version"):
        print("Antigravity CLI v2.0.0 (Google Antigravity Engine)")
        sys.exit(0)

    parser = argparse.ArgumentParser(description="Antigravity CLI Control Interface", add_help=False)
    parser.add_argument("--model", "-m", default="Gemini 3.7 Flash", help="Antigravity Model")
    parser.add_argument("--effort", "-e", default="High", help="Reasoning Effort")
    parser.add_argument("--prompt", "-p", default="", help="Single prompt execution")
    parser.add_argument("rest", nargs="*", help="Direct prompt arguments")

    args, unknown = parser.parse_known_args()

    model = args.model
    effort = args.effort
    prompt_parts = []
    if args.prompt:
        prompt_parts.append(args.prompt)
    if args.rest:
        prompt_parts.extend(args.rest)
    if unknown:
        prompt_parts.extend(unknown)

    prompt = " ".join(prompt_parts).strip()

    if prompt:
        print_banner(model, effort)
        run_agent_task(prompt, model=model, effort=effort)
    else:
        interactive_repl(model, effort)

if __name__ == "__main__":
    main()
