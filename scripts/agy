      <a href="#stats">Telemetry</a>
    </nav>
    <button class="cta-btn" id="launchBtn">Live Preview</button>
  </header>

  <main>
    <section class="hero">
      <div class="badge">● ANTIGRAVITY ENGINE V2.0 ACTIVE</div>
      <h1>Next-Gen Autonomous <span class="gradient-text">Vibecoding Experience</span></h1>
      <p>Engineered with Obsidian Titanium aesthetic, real-time telemetry, and full-stack local control.</p>
      
      <div class="interactive-terminal" id="terminal">
        <div class="term-header">
          <div class="dots"><span></span><span></span><span></span></div>
          <div class="term-title">agy@macbook ~ %</div>
        </div>
        <div class="term-body">
          <p class="term-line"><span class="prompt">agy></span> <span class="cmd">build website theme --obsidian-titanium</span></p>
          <p class="term-out success">✓ Project generated in {target_dir}</p>
          <p class="term-out info">ℹ Live hot-reload server listening on port 3000</p>
          <p class="term-line typing"><span class="prompt">agy></span> <span class="cursor">█</span></p>
        </div>
      </div>
    </section>
  </main>

  <script src="app.js"></script>
</body>
</html>"""

        css_content = """* { box-sizing: border-box; margin: 0; padding: 0; }
