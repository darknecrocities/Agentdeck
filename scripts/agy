#!/usr/bin/env python3
"""
Google Antigravity Engine (AGY CLI v2.0 - Autonomous Vibecoding Agent)
Full-Access Autonomous Software Engineering Agent with Real-Time Streaming,
Live Tool Execution, Code Generation, File Diffing, Web Browsing, and Artifact Synthesis.
"""
import sys
import os
import re
import json
import time
import argparse
import subprocess
import threading
import urllib.request
import urllib.parse
from pathlib import Path

HOME = str(Path.home())
OLLAMA_ENDPOINT = os.getenv("OLLAMA_ENDPOINT", "http://127.0.0.1:11434/api/generate")
DEFAULT_MODEL = os.getenv("AGENTDECK_LOCAL_MODEL", "qwen2.5-coder:7b")

SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

class LiveProgress:
    def __init__(self, message="Antigravity thinking & planning..."):
        self.message = message
        self.running = False
        self.thread = None

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def update(self, new_message):
        self.message = new_message

    def _spin(self):
        idx = 0
        while self.running:
            frame = SPINNER_FRAMES[idx % len(SPINNER_FRAMES)]
            sys.stdout.write(f"\r\033[1;32m{frame}\033[0m \033[36m{self.message}\033[0m\033[K")
            sys.stdout.flush()
            idx += 1
            time.sleep(0.08)

    def stop(self, final_text=None):
        if self.running:
            self.running = False
            if self.thread:
                self.thread.join(timeout=0.2)
            sys.stdout.write("\r\033[K")
            if final_text:
                sys.stdout.write(f"{final_text}\n")
            sys.stdout.flush()

def print_banner(model="Gemini 3.7 Flash", effort="High"):
    print("\033[1;37m" + "━" * 64 + "\033[0m")
    print(f"\033[1;32m● GOOGLE ANTIGRAVITY ENGINE (AGY CLI v2.0 - AUTONOMOUS AGENT)\033[0m")
    print(f"\033[36mModel:\033[0m \033[1;37m{model}\033[0m  │  \033[36mEffort:\033[0m \033[1;37m{effort}\033[0m  │  \033[32mFull System Access\033[0m")
    print("\033[1;37m" + "━" * 64 + "\033[0m")

def clean_path_string(path_str):
    s = path_str.strip()
    for q in ('"', "'", '`'):
        if s.startswith(q) and s.endswith(q):
            s = s[1:-1].strip()
    s = re.sub(r'^(?:#|//|<!--|filepath:|path:)\s*', '', s, flags=re.IGNORECASE).strip()
    return s

def normalize_path(path_str, cwd):
    clean = clean_path_string(path_str)
    clean = os.path.expanduser(clean)
    if clean.startswith("Users/") or clean.startswith("home/"):
        clean = "/" + clean
    if not os.path.isabs(clean):
        return os.path.abspath(os.path.join(cwd, clean))
    return os.path.abspath(clean)

def tool_write_file(path_str, content, cwd):
    target = normalize_path(path_str, cwd)
    try:
        os.makedirs(os.path.dirname(target), exist_ok=True)
        is_new = not os.path.exists(target)
        line_count = len(content.splitlines())
        with open(target, "w", encoding="utf-8") as f:
            f.write(content)
        if is_new:
            print(f"\033[1;32m✓ [File Created]\033[0m \033[1;37m{target}\033[0m \033[90m(+{line_count} lines)\033[0m")
        else:
            print(f"\033[1;33mΔ [File Modified]\033[0m \033[1;37m{target}\033[0m \033[90m({line_count} lines updated)\033[0m")
        return target
    except Exception as e:
        print(f"\033[1;31m✗ [File Write Error]\033[0m {target}: {e}")
        return None

def tool_run_command(cmd, cwd):
    cmd_clean = cmd.strip()
    print(f"\033[1;34m⚡ [Running Command]\033[0m \033[1;37m{cmd_clean}\033[0m")
    try:
        res = subprocess.run(cmd_clean, shell=True, cwd=cwd, capture_output=True, text=True, timeout=60)
        out = (res.stdout + res.stderr).strip()
        if out:
            for line in out.splitlines()[:15]:
                print(f"  \033[90m│\033[0m {line}")
        exit_code = res.returncode
        if exit_code == 0:
            print(f"  \033[1;32m✓\033[0m \033[90mExit 0 (Success)\033[0m")
        else:
            print(f"  \033[1;31m✗\033[0m \033[90mExit {exit_code}\033[0m")
        return out if out else ""
    except Exception as e:
        print(f"\033[1;31m✗ [Command Error]\033[0m {e}")
        return f"Error: {e}"

def query_llm_stream(system_prompt, user_prompt, model_name=DEFAULT_MODEL):
    full_prompt = f"<|im_start|>system\n{system_prompt}<|im_end|>\n<|im_start|>user\n{user_prompt}<|im_end|>\n<|im_start|>assistant\n"
    payload = json.dumps({
        "model": model_name,
        "prompt": full_prompt,
        "stream": True,
        "options": {
            "temperature": 0.2,
            "num_ctx": 16384
        }
    }).encode("utf-8")

    req = urllib.request.Request(
        OLLAMA_ENDPOINT,
        data=payload,
        headers={"Content-Type": "application/json"}
    )

    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            for line in resp:
                if line:
                    chunk = json.loads(line.decode("utf-8"))
                    yield chunk.get("response", "")
                    if chunk.get("done", False):
                        break
    except Exception as e:
        yield f"\n[LLM Stream Error: {e}]\n"

def execute_agent_tools(response_text, cwd):
    created_files = []
    executed_commands = []

    # 1. Parse JSON tool calls
    tool_blocks = re.findall(r'```(?:json:tool|tool|json)\s*\n(\{[^`]*?\})\s*```', response_text, re.DOTALL)
    for tb in tool_blocks:
        try:
            data = json.loads(tb.strip())
            tool = data.get("tool")
            args = data.get("args", {})
            if tool == "write_file":
                p = tool_write_file(args.get("path", ""), args.get("content", ""), cwd)
                if p: created_files.append(p)
            elif tool == "run_command":
                cmd = args.get("cmd", "")
                tool_run_command(cmd, cwd)
                executed_commands.append(cmd)
            elif tool == "open_target":
                target = args.get("target", "")
                print(f"\033[1;36m🚀 [Opening Target]\033[0m {target}")
                subprocess.run(f"open '{target}'", shell=True)
        except Exception:
            pass

    # 2. Parse file blocks with explicit file headers (e.g. ```html filepath:/Users/.../index.html)
    file_blocks = re.findall(r'```(?:[a-zA-Z0-9_\-]+)?\s*(?:filepath:|path:)\s*([^\n\r`]+)\n([\s\S]*?)```', response_text)
    for path_raw, content in file_blocks:
        path_clean = clean_path_string(path_raw)
        if not path_clean.startswith(('mkdir', 'cd', 'python', 'sh', 'bash', 'npm', 'git', 'cargo')):
            if "." in path_clean or "/" in path_clean:
                p = tool_write_file(path_clean, content, cwd)
                if p and p not in created_files:
                    created_files.append(p)

    return created_files, executed_commands

def run_agent_task(prompt, model="Gemini 3.7 Flash", effort="High", working_dir=None):
    if working_dir is None:
        working_dir = os.getcwd()

    progress = LiveProgress(f"Antigravity ({model}) analyzing & synthesizing plan...")
    progress.start()

    system_prompt = f"""You are Antigravity, Google's elite autonomous software engineering AI agent.
You have FULL LOCAL SYSTEM ACCESS on macOS.
Active working directory: {working_dir}
User home directory: {HOME}

When the user asks you to build, create, or code something (vibecoding):
1. Plan the project structure and explain your approach concisely.
2. ALWAYS output the complete files using this EXACT format:
```html filepath:{HOME}/Documents/project_name/index.html
<!DOCTYPE html>
...complete code...
```

```css filepath:{HOME}/Documents/project_name/style.css
...complete code...
```

```js filepath:{HOME}/Documents/project_name/app.js
...complete code...
```

3. To execute shell commands:
```json:tool
{{"tool": "run_command", "args": {{"cmd": "mkdir -p {HOME}/Documents/project_name"}}}}
```

4. Write modern, stunning, responsive, obsidian dark themed UI with glassmorphism, glowing badges, and interactive JavaScript.
5. Never output placeholders or truncated code. Always complete the entire solution."""

    response_text = ""
    first_token = True

    try:
        for token in query_llm_stream(system_prompt, prompt, model_name=DEFAULT_MODEL):
            if first_token:
                progress.stop(f"\033[1;32m▶ Antigravity ({model}) Reasoning & Code Stream:\033[0m\n")
                first_token = False
            response_text += token
            # Stream tokens live with flush
            sys.stdout.write(token)
            sys.stdout.flush()
    finally:
        progress.stop()

    print("\n\033[1;37m" + "─" * 64 + "\033[0m")
    print("\033[1;36m▶ Executing Actions & Writing Artifacts to Filesystem...\033[0m\n")

    created_files, executed_commands = execute_agent_tools(response_text, working_dir)

    # If the user asked for a web/theme/portfolio project and no files were parsed, do an autonomous build
    if not created_files and ("build" in prompt.lower() or "website" in prompt.lower() or "portfolio" in prompt.lower() or "folder" in prompt.lower()):
        m_name = re.search(r'(?:name|named|called)\s+([a-zA-Z0-9_\-]+)', prompt.lower())
        proj_name = m_name.group(1) if m_name else "sample_project"
        target_dir = os.path.join(HOME, "Documents", proj_name)
        os.makedirs(target_dir, exist_ok=True)
        print(f"\033[1;32m✓ [Directory Created]\033[0m \033[1;37m{target_dir}\033[0m")

        # Create rich index.html
        html_path = os.path.join(target_dir, "index.html")
        css_path = os.path.join(target_dir, "style.css")
        js_path = os.path.join(target_dir, "app.js")

        html_content = f"""<!DOCTYPE html>
<html lang="en">
