<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentdeck.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/arronkianparejas/.local/bin/agentdeckd</string>
        <string>--config</string>
        <string>/path/to/your/projects/agentdeck.toml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/your/projects</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
    </array>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/arronkianparejas/.gemini/agentdeck/logs/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/arronkianparejas/.gemini/agentdeck/logs/daemon.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>RUST_LOG</key>
        <string>agentdeck=info,agentdeckd=info,tower_http=info</string>
    </dict>
</dict>
</plist>
